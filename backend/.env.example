# Copia este archivo a ".env" y ajusta los valores a tu instalación.

# Cadena de conexión a PostgreSQL.
#   - Dentro de Docker -> docker-compose inyecta db:5432 automáticamente.
DATABASE_URL=postgresql+psycopg2://firewatch_user:firewatch_pass@localhost:5432/firewatch_qro

# Claves secretas de seguridad
SECRET_KEY=clave-super-secreta-firewatch-2026
JWT_SECRET_KEY=clave-jwt-super-secreta-firewatch-2026

# Puerto del servidor backend
FLASK_PORT=5000

# Modo debug (1 = activo, 0 = desactivado)
FLASK_DEBUG=1

