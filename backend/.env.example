# Copia este archivo a ".env" y ajusta los valores a tu instalación.

# Cadena de conexión a MySQL.
#   - Local (backend sin Docker) -> apunta al puerto 3307 (MySQL en contenedor)
#     o 3306 si usas MySQL instalado directamente en tu PC.
#   - Dentro de Docker -> docker-compose inyecta db:3306 automáticamente.
DATABASE_URL=mysql+pymysql://firewatch_user:firewatch_pass@localhost:3307/firewatch_qro

# Claves secretas de seguridad
SECRET_KEY=clave-super-secreta-firewatch-2026
JWT_SECRET_KEY=clave-jwt-super-secreta-firewatch-2026

# Puerto del servidor backend
FLASK_PORT=5000

# Modo debug (1 = activo, 0 = desactivado)
FLASK_DEBUG=1

