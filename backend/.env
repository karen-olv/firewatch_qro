# Conexión MySQL FireWatch QRO (corriendo el backend LOCALMENTE)
# MySQL en Docker se expone en el puerto 3307 del host.
# Si usas una instalación local de MySQL sin Docker, cambia a localhost:3306
DATABASE_URL=mysql+pymysql://firewatch_user:firewatch_pass@localhost:3307/firewatch_qro

# Seguridad Flask
SECRET_KEY=firewatch_secret_2026_seguro
JWT_SECRET_KEY=firewatch_jwt_secret_2026_seguro

# Puerto backend
FLASK_PORT=5000

